# Shared staff login
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin123
LOCAL_AUTH_SECRET=change-me-to-a-long-random-string

# Public site URL (used inside QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required on Vercel so bookings persist)
# Leave empty locally to use .data/bookings.json instead
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
